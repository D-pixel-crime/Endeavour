# Database connection (Orchestrator DB where workflows and outbox reside)
SWEEPER_DATABASE_URL=insert_orchestrator_db_url_here

# Sweeper configuration
SWEEPER_POLL_INTERVAL_SECONDS=5
SWEEPER_BATCH_SIZE=50
SWEEPER_VISIBILITY_TIMEOUT_SECONDS=30

# SQS Queue Redrive MaxReceiveCount Configuration (Matches AWS SQS RedrivePolicy)
# StateTimeout = (SQS_INGRESS_MAX_RETRIES * IngressVis) + (SQS_EGRESS_MAX_RETRIES * EgressVis) + STAGE_TIMEOUT_BUFFER_SECONDS
SQS_INGRESS_MAX_RETRIES=5
SQS_EGRESS_MAX_RETRIES=3
STAGE_TIMEOUT_BUFFER_SECONDS=10
