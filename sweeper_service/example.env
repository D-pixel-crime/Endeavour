# Database connection (Orchestrator DB where workflows and outbox reside)
SWEEPER_DATABASE_URL=postgres://user:password@localhost:5432/orchestrator_db?sslmode=disable
# Alternatively, it will automatically fallback to ORCHESTRATOR_DB_URL or DATABASE_URL:
# ORCHESTRATOR_DB_URL=postgres://user:password@localhost:5432/orchestrator_db?sslmode=disable

# Sweeper configuration
SWEEPER_POLL_INTERVAL_SECONDS=5
SWEEPER_BATCH_SIZE=50
SWEEPER_TASK_TIMEOUT_SECONDS=15
SWEEPER_PORT=3004
