ORCHESTRATOR_DB_URL=supabase_url
ORCHESTRATOR_PORT=8080
BOOKING_EGRESS_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/booking-egress-queue.fifo
BOOKING_EGRESS_VISIBILITY_TIMEOUT_SECONDS=30
PAYMENT_EGRESS_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/payment-egress-queue.fifo
PAYMENT_EGRESS_VISIBILITY_TIMEOUT_SECONDS=30
BOOKING_TASK_TIMEOUT_SECONDS=15
PAYMENT_TASK_TIMEOUT_SECONDS=15
ORCHESTRATOR_POLL_INTERVAL_SECONDS=5
ORCHESTRATOR_MAX_CONCURRENT_PULLS=5

# Rate Limiting & Concurrency Settings (Token Bucket & Concurrency Semaphore)
RATE_LIMIT_POST_RPS=10.0
RATE_LIMIT_POST_BURST=20
RATE_LIMIT_GET_RPS=50.0
RATE_LIMIT_GET_BURST=100
MAX_CONCURRENT_WORKFLOW_CREATIONS=25