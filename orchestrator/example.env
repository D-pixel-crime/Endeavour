ORCHESTRATOR_DB_URL=insert_orchestrator_db_url_here
ORCHESTRATOR_PORT=8080
BOOKING_EGRESS_SQS_URL=insert_booking_egress_sqs_url_here
BOOKING_INGRESS_VISIBILITY_TIMEOUT_SECONDS=30
BOOKING_EGRESS_VISIBILITY_TIMEOUT_SECONDS=30
PAYMENT_EGRESS_SQS_URL=insert_payment_egress_sqs_url_here
PAYMENT_INGRESS_VISIBILITY_TIMEOUT_SECONDS=30
PAYMENT_EGRESS_VISIBILITY_TIMEOUT_SECONDS=30
ORCHESTRATOR_POLL_INTERVAL_SECONDS=5
ORCHESTRATOR_MAX_CONCURRENT_PULLS=5

# SQS Queue Redrive MaxReceiveCount Configuration (Matches AWS SQS RedrivePolicy)
# StateTimeout = (SQS_INGRESS_MAX_RETRIES * IngressVis) + (SQS_EGRESS_MAX_RETRIES * EgressVis) + STAGE_TIMEOUT_BUFFER_SECONDS
SQS_INGRESS_MAX_RETRIES=5
SQS_EGRESS_MAX_RETRIES=3
STAGE_TIMEOUT_BUFFER_SECONDS=10

# Rate Limiting & Concurrency Settings (Token Bucket & Concurrency Semaphore)
RATE_LIMIT_POST_RPS=10.0
RATE_LIMIT_POST_BURST=20
RATE_LIMIT_GET_RPS=50.0
RATE_LIMIT_GET_BURST=100
MAX_CONCURRENT_WORKFLOW_CREATIONS=25
