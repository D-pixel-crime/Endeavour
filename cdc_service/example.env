# ==========================================
# Generic Standalone CDC Service Configuration
# ==========================================

# Service identification & HTTP port for /health and /stats
CDC_SERVICE_NAME=cdc-service
CDC_PORT=8080

# Polling interval in seconds (default: 5)
CDC_ORCHESTRATOR_INTERVAL_SECONDS= # Fill only one for which config is required
CDC_BOOKING_INTERVAL_SECONDS=
CDC_PAYMENT_INTERVAL_SECONDS=

# Batch size for SQS batch send (1-10, default: 10)
CDC_BATCH_SIZE=10

# Database connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/my_service_db?sslmode=disable

# ------------------------------------------------------------------
# OPTION 1: SINGLE Queue Mode (e.g. Booking / Payment Egress)
# ------------------------------------------------------------------
CDC_MODE=SINGLE
TARGET_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/booking-egress-queue

# ------------------------------------------------------------------
# OPTION 2: MULTI / DUAL Queue Mode (e.g. Orchestrator Routing)
# ------------------------------------------------------------------
# CDC_MODE=MULTI
# TARGET_QUEUES=BOOKING:https://sqs.us-east-1.amazonaws.com/123456789012/booking-ingress-queue,PAYMENT:https://sqs.us-east-1.amazonaws.com/123456789012/payment-ingress-queue
#
# Alternatively, specify individual worker queues:
# TARGET_QUEUE_BOOKING=https://sqs.us-east-1.amazonaws.com/123456789012/booking-ingress-queue
# TARGET_QUEUE_PAYMENT=https://sqs.us-east-1.amazonaws.com/123456789012/payment-ingress-queue
